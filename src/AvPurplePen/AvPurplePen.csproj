<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);PORTING</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>$(DefineConstants);PORTING</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AvPurplePen.App/AvPurplePen.App.csproj" />
  </ItemGroup>

  <!-- Build PdfConverter as a standalone exe tool.
       Uses a direct MSBuild task instead of ProjectReference so the publish
       pipeline does not try to resolve PdfConverter's output files (which
       fails when PublishReadyToRun adds a RID-specific output path). -->
  <PropertyGroup>
    <PdfConverterOutputDir>../PdfConverter/bin/$(Configuration)/net10.0/</PdfConverterOutputDir>
  </PropertyGroup>

  <Target Name="BuildPdfConverter" BeforeTargets="Build;Publish">
    <MSBuild Projects="../PdfConverter/PdfConverter.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=net10.0;RuntimeIdentifier=;SelfContained=;PublishDir=;PublishReadyToRun=" />
  </Target>

  <!-- Copy PdfConverter output to AvPurplePen output directory after build. -->
  <Target Name="CopyPdfConverterToBuildOutput" AfterTargets="Build" DependsOnTargets="BuildPdfConverter">
    <ItemGroup>
      <PdfConverterBuildFiles Include="$(PdfConverterOutputDir)**/*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PdfConverterBuildFiles)" DestinationFiles="@(PdfConverterBuildFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy PdfConverter output to publish directory after publish. -->
  <Target Name="CopyPdfConverterToPublishOutput" AfterTargets="Publish" DependsOnTargets="BuildPdfConverter">
    <ItemGroup>
      <PdfConverterPublishFiles Include="$(PdfConverterOutputDir)**/*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PdfConverterPublishFiles)" DestinationFiles="@(PdfConverterPublishFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
