<!--
    PunchPatternsDialog.axaml
    Dialog for managing punch patterns.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PurplePen.ViewModels"
        xmlns:resx="using:AvPurplePen"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="400" d:DesignHeight="400"
        x:Class="AvPurplePen.Views.PunchPatternsDialog"
        x:DataType="vm:PunchPatternsDialogViewModel"
        Title="{resx:Localize PunchPatternDialog_Text}"
        Icon="/Assets/transparent.ico"
        Width="400" Height="400"
        CanResize="True"
        CanMinimize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Design.DataContext>
        <vm:PunchPatternsDialogViewModel/>
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <!-- Button Bar -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DialogButtonBarBorderBrush}" Padding="16,12" Background="{DynamicResource DialogButtonBarBackground}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="okButton"
                        Content="{x:Static resx:UIText.OKButton}"
                        Command="{Binding OkCommand}"
                        MinWidth="90" Padding="12,6"
                        IsDefault="True"/>
                <Button x:Name="cancelButton"
                        Content="{x:Static resx:UIText.CancelButton}"
                        Command="{Binding CancelCommand}"
                        MinWidth="90" Padding="12,6"
                        IsCancel="True"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Border Padding="20">
            <Grid RowDefinitions="Auto,*">

                <!-- Header -->
                <TextBlock Grid.Row="0"
                           Text="{resx:Localize PunchPatternDialog_punchPatternsLabel_Text}"
                           FontSize="12" FontWeight="Bold" Margin="0,0,0,12"/>

                <!-- List -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Patterns}"
                         SelectedItem="{Binding SelectedPattern}"
                         MinHeight="200"/>

            </Grid>
        </Border>

    </DockPanel>

</Window>
