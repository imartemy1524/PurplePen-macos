<!--
    CreateOcadFiles.axaml

    Dialog for exporting OCAD/OpenMapper course files.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PurplePen.ViewModels"
        xmlns:resx="using:AvPurplePen"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="700" d:DesignHeight="620"
        x:Class="AvPurplePen.Views.CreateOcadFiles"
        x:DataType="vm:CreateOcadFilesViewModel"
        Classes="dialog"
        Title="{resx:Localize CreateOcadFiles_Text}"
        Icon="/Assets/transparent.ico"
        Width="700" Height="620"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Design.DataContext>
        <vm:CreateOcadFilesViewModel/>
    </Design.DataContext>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button x:Name="createButton"
                    Content="{resx:Localize CreateOcadFiles_createButton_Text}"
                    Width="85"
                    HorizontalContentAlignment="Center"
                    IsDefault="True"
                    IsEnabled="{Binding IsOkEnabled}"
                    Click="CreateButton_Click"/>
            <Button x:Name="cancelButton"
                    Content="{resx:Localize CreateOcadFiles_cancelButton_Text}"
                    Width="85"
                    HorizontalContentAlignment="Center"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>

        <Grid RowDefinitions="*,Auto,Auto"
              RowSpacing="12">
            <Border Grid.Row="0"
                    Classes="groupBox"
                    Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8"
                                Margin="0,10,0,0">
                        <Button Content="{resx:Localize CourseSelector_selectAll_Text}"
                                Command="{Binding CourseSelection.SelectAllCoursesCommand}"/>
                        <Button Content="{resx:Localize CourseSelector_selectNone_Text}"
                                Command="{Binding CourseSelection.SelectNoCoursesCommand}"/>
                        <Button Content="{resx:Localize CourseSelector_buttonChooseVariations_Text}"
                                Command="{Binding CourseSelection.ChooseVariationsCommand}"
                                IsVisible="{Binding CourseSelection.IsChooseVariationsVisible}"
                                IsEnabled="{Binding CourseSelection.IsChooseVariationsEnabled}"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="groupHeader"
                                   Text="{resx:Localize CreateOcadFiles_coursesGroupBox_Text}"/>
                        <ListBox x:Name="courseListBox"
                                 ItemsSource="{Binding CourseSelection.Courses}"
                                 SelectedItem="{Binding CourseSelection.SelectedCourse, Mode=TwoWay}"
                                 Height="220">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PdfCourseItemViewModel">
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Classes="groupBox"
                    Padding="12">
                <StackPanel Spacing="10">
                    <TextBlock Classes="groupHeader"
                               Text="{resx:Localize CreateOcadFiles_outputGroupBox_Text}"/>
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{resx:Localize CreateOcadFiles_fileFormatLabel_Text}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding FileFormatOptions}"
                                  SelectedIndex="{Binding SelectedFileFormatIndex, Mode=TwoWay}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{resx:Localize CreateOcadFiles_fileNamePrefixLabel_Text}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding FilePrefix, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Classes="groupBox"
                    Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Classes="groupHeader"
                               Text="{resx:Localize CreateOcadFiles_folderGroupBox_Text}"/>
                    <RadioButton GroupName="OcadOutputFolder"
                                 Content="{resx:Localize CreateOcadFiles_coursesDirectory_Text}"
                                 IsChecked="{Binding OutputFolder.IsCoursesDirectory, Mode=TwoWay}"/>
                    <RadioButton GroupName="OcadOutputFolder"
                                 Content="{resx:Localize CreateOcadFiles_mapDirectory_Text}"
                                 IsChecked="{Binding OutputFolder.IsMapDirectory, Mode=TwoWay}"/>
                    <RadioButton GroupName="OcadOutputFolder"
                                 Content="{resx:Localize CreateOcadFiles_otherDirectory_Text}"
                                 IsChecked="{Binding OutputFolder.IsOtherDirectory, Mode=TwoWay}"/>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8"
                          IsVisible="{Binding OutputFolder.IsOtherDirectoryVisible}">
                        <TextBox Grid.Column="0"
                                 Text="{Binding OutputFolder.OutputDirectory, Mode=TwoWay}"/>
                        <Button Grid.Column="1"
                                Content="{resx:Localize CreateOcadFiles_selectOtherDirectoryButton_Text}"
                                Command="{Binding OutputFolder.SelectOtherDirectoryCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
