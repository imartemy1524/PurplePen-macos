<!--
    LegAssignmentsDialog.axaml

    Dialog for assigning fixed legs to relay branches.
    Migrated from WinForms PurplePen/LegAssignmentsDialog.cs.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PurplePen.ViewModels"
        xmlns:resx="using:AvPurplePen"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="AvPurplePen.Views.LegAssignmentsDialog"
        Classes="dialog"
        x:DataType="vm:LegAssignmentsDialogViewModel"
        Title="{resx:Localize LegAssignmentsDialog_Text}"
        Icon="/Assets/transparent.ico"
        Width="560"
        Height="420"
        CanResize="True"
        CanMinimize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Design.DataContext>
        <vm:LegAssignmentsDialogViewModel/>
    </Design.DataContext>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,20,0,0">
            <Button x:Name="okButton"
                    Content="{resx:Localize OKButton}"
                    Width="85"
                    HorizontalContentAlignment="Center"
                    IsDefault="True"
                    Click="OkButton_Click"/>
            <Button x:Name="cancelButton"
                    Content="{resx:Localize CancelButton}"
                    Width="85"
                    HorizontalContentAlignment="Center"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock x:Name="labelDescription"
                       Text="{resx:Localize LegAssignmentsDialog_labelDescription_Text}"
                       TextWrapping="Wrap"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LegAssignmentRowViewModel">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                                <Border Background="Transparent"
                                        Padding="4,6,10,6">
                                    <TextBlock Text="{Binding BranchCode}"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBox Grid.Column="1"
                                         Text="{Binding LegsText, Mode=TwoWay}"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </DockPanel>
</Window>
