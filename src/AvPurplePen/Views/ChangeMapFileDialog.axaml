<!--
    ChangeMapFileDialog.axaml
    Dialog for changing the map file.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PurplePen.ViewModels"
        xmlns:resx="using:AvPurplePen"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="500" d:DesignHeight="400"
        x:Class="AvPurplePen.Views.ChangeMapFileDialog"
        x:DataType="vm:ChangeMapFileDialogViewModel"
        Title="{resx:Localize MainFrame_changeMapFileMenu_Text}"
        Icon="/Assets/transparent.ico"
        Width="500" Height="400"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Design.DataContext>
        <vm:ChangeMapFileDialogViewModel/>
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <!-- Button Bar -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DialogButtonBarBorderBrush}" Padding="16,12" Background="{DynamicResource DialogButtonBarBackground}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="okButton"
                        Content="{x:Static resx:UIText.OKButton}"
                        Command="{Binding OkCommand}"
                        MinWidth="90" Padding="12,6"
                        IsDefault="True"/>
                <Button x:Name="cancelButton"
                        Content="{x:Static resx:UIText.CancelButton}"
                        Command="{Binding CancelCommand}"
                        MinWidth="90" Padding="12,6"
                        IsCancel="True"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Border Padding="20">
            <StackPanel Spacing="16">

            <!-- Map Type -->
            <StackPanel Spacing="6">
                <TextBlock Text="{resx:Localize AvChangeMapFile_mapTypeLabel_Text}" FontWeight="Bold" FontSize="13"/>
                <TextBlock Text="{Binding MapTypeName}" FontSize="12" Foreground="{DynamicResource HintTextBrush}"/>
            </StackPanel>

            <!-- Map File -->
            <StackPanel Spacing="6">
                <TextBlock Text="{resx:Localize ChangeMapFile_mapFileDisplay_Text}" FontWeight="Bold" FontSize="13"/>
                <TextBox Text="{Binding MapFileName, Mode=TwoWay}"
                         MinHeight="36"
                         IsReadOnly="True"/>
            </StackPanel>

            <!-- Map Scale (if applicable) -->
            <StackPanel Spacing="6">
                <TextBlock Text="{resx:Localize ChangeMapFile_labelScale_Text}" FontWeight="Bold" FontSize="13"/>
                <NumericUpDown Value="{Binding MapScale, Mode=TwoWay}"
                               Minimum="0.1" Maximum="100"
                               Increment="0.1"
                               MinHeight="36"/>
            </StackPanel>

            <!-- DPI (for bitmap) -->
            <StackPanel Spacing="6" IsVisible="{Binding ShowDpiControl}">
                <TextBlock Text="{resx:Localize ChangeMapFile_labelDpi_Text}" FontWeight="Bold" FontSize="13"/>
                <NumericUpDown Value="{Binding MapDpi, Mode=TwoWay}"
                               Minimum="72" Maximum="600"
                               Increment="1"
                               MinHeight="36"/>
            </StackPanel>

            <TextBlock Text="{resx:Localize AvChangeMapFile_note_Text}"
                       TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>

            </StackPanel>
        </Border>

    </DockPanel>

</Window>
