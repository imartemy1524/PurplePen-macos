<!--
    ChangeCodesDialog.axaml
    Dialog for editing control point codes.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PurplePen.ViewModels"
        xmlns:resx="using:AvPurplePen"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="500" d:DesignHeight="500"
        x:Class="AvPurplePen.Views.ChangeCodesDialog"
        x:DataType="vm:ChangeCodesDialogViewModel"
        Title="{resx:Localize ChangeAllCodes_Text}"
        Icon="/Assets/transparent.ico"
        Width="500" Height="500"
        CanResize="True"
        CanMinimize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Design.DataContext>
        <vm:ChangeCodesDialogViewModel/>
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <!-- Button Bar -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DialogButtonBarBorderBrush}" Padding="16,12" Background="{DynamicResource DialogButtonBarBackground}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="okButton"
                        Content="{x:Static resx:UIText.OKButton}"
                        Command="{Binding OkCommand}"
                        MinWidth="90" Padding="12,6"
                        IsDefault="True"/>
                <Button x:Name="cancelButton"
                        Content="{x:Static resx:UIText.CancelButton}"
                        Command="{Binding CancelCommand}"
                        MinWidth="90" Padding="12,6"
                        IsCancel="True"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Border Padding="20">
            <Grid RowDefinitions="Auto,*">

                <!-- Header -->
                <TextBlock Grid.Row="0"
                           Text="{resx:Localize ChangeAllCodes_changeControlCodesLabel_Text}"
                           FontSize="12" Foreground="{DynamicResource HintTextBrush}" Margin="0,0,0,12"/>

                <!-- Code List -->
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Codes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SectionDividerBrush}" Padding="0,8">
                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ControlNumber}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource HintTextBrush}"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Code, Mode=TwoWay}"
                                                 Margin="12,0,0,0"
                                                 Padding="8,4"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>
        </Border>

    </DockPanel>

</Window>
