<!--
    CustomizeDescriptionsDialog.axaml
    Dialog for customizing symbol descriptions.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PurplePen.ViewModels"
        xmlns:resx="using:AvPurplePen"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="500" d:DesignHeight="400"
        x:Class="AvPurplePen.Views.CustomizeDescriptionsDialog"
        x:DataType="vm:CustomizeDescriptionsDialogViewModel"
        Title="Customize Descriptions"
        Icon="/Assets/transparent.ico"
        Width="500" Height="400"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Design.DataContext>
        <vm:CustomizeDescriptionsDialogViewModel/>
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <!-- Button Bar -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0" Padding="16,12" Background="#F5F5F5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="okButton"
                        Content="OK"
                        Command="{Binding OkCommand}"
                        MinWidth="90" Padding="12,6"
                        IsDefault="True"/>
                <Button x:Name="cancelButton"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        MinWidth="90" Padding="12,6"
                        IsCancel="True"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Border Padding="20">
            <StackPanel Spacing="16">

                <TextBlock Text="Customize Course Descriptions"
                           FontWeight="Bold" FontSize="14"/>

                <TextBlock Text="Select language for customization:"
                           FontSize="12" Foreground="#666"/>

                <!-- Language Selection -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Language:" FontWeight="Bold" FontSize="13"/>
                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding CurrentLanguage}"
                              MinHeight="36"/>
                </StackPanel>

                <!-- Current Language Display -->
                <Border BorderThickness="1" BorderBrush="#DDD" Background="#F9F9F9" Padding="12">
                    <TextBlock Text="{Binding CurrentLanguage, StringFormat='Current: {0}'}"
                               FontSize="12"/>
                </Border>

                <!-- Option -->
                <CheckBox Content="Set as default language for new events"
                          IsChecked="{Binding UseAsDefault, Mode=TwoWay}"/>

                <TextBlock Text="Note: Full symbol text customization interface coming soon."
                           TextWrapping="Wrap"
                           FontSize="11" Foreground="#888"/>

            </StackPanel>
        </Border>

    </DockPanel>

</Window>
