<!--
    CustomizeDescriptionsDialog.axaml
    Dialog for customizing symbol descriptions.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PurplePen.ViewModels"
        xmlns:resx="using:AvPurplePen"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="500" d:DesignHeight="400"
        x:Class="AvPurplePen.Views.CustomizeDescriptionsDialog"
        x:DataType="vm:CustomizeDescriptionsDialogViewModel"
        Title="{resx:Localize MainFrame_customizeDescriptionsMenu_Text}"
        Icon="/Assets/transparent.ico"
        Width="500" Height="400"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Design.DataContext>
        <vm:CustomizeDescriptionsDialogViewModel/>
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <!-- Button Bar -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DialogButtonBarBorderBrush}" Padding="16,12" Background="{DynamicResource DialogButtonBarBackground}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="okButton"
                        Content="{x:Static resx:UIText.OKButton}"
                        Command="{Binding OkCommand}"
                        MinWidth="90" Padding="12,6"
                        IsDefault="True"/>
                <Button x:Name="cancelButton"
                        Content="{x:Static resx:UIText.CancelButton}"
                        Command="{Binding CancelCommand}"
                        MinWidth="90" Padding="12,6"
                        IsCancel="True"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Border Padding="20">
            <StackPanel Spacing="16">

                <TextBlock Text="{resx:Localize MainFrame_customizeDescriptionsMenu_Text}"
                           FontWeight="Bold" FontSize="14"/>

                <TextBlock Text="{resx:Localize CustomSymbolText_labelChooseLanguage_Text}"
                           FontSize="12" Foreground="{DynamicResource HintTextBrush}"/>

                <!-- Language Selection -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{resx:Localize CustomSymbolText_labelChooseLanguage_Text}" FontWeight="Bold" FontSize="13"/>
                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding CurrentLanguage}"
                              MinHeight="36"/>
                </StackPanel>

                <!-- Current Language Display -->
                <Border BorderThickness="1" BorderBrush="{DynamicResource SectionDividerBrush}" Background="{DynamicResource PanelAltBackground}" Padding="12">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{resx:Localize AvCustomizeDescriptions_currentLanguageLabel_Text}" FontSize="12"/>
                        <TextBlock Text="{Binding CurrentLanguage}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Option -->
                <CheckBox Content="{resx:Localize CustomSymbolText_checkBoxDefaultLanguage_Text}"
                          IsChecked="{Binding UseAsDefault, Mode=TwoWay}"/>

                <TextBlock Text="{resx:Localize AvCustomizeDescriptions_note_Text}"
                           TextWrapping="Wrap"
                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>

            </StackPanel>
        </Border>

    </DockPanel>

</Window>
