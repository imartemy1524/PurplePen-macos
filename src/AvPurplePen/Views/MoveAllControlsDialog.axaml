<!--
    MoveAllControlsDialog.axaml
    Dialog for selecting how to move all controls.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PurplePen.ViewModels"
        xmlns:resx="using:AvPurplePen"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="450" d:DesignHeight="350"
        x:Class="AvPurplePen.Views.MoveAllControlsDialog"
        x:DataType="vm:MoveAllControlsDialogViewModel"
        Title="Move All Controls"
        Icon="/Assets/transparent.ico"
        Width="450" Height="350"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Design.DataContext>
        <vm:MoveAllControlsDialogViewModel/>
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <!-- Button Bar -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0" Padding="16,12" Background="#F5F5F5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="okButton"
                        Content="OK"
                        Command="{Binding OkCommand}"
                        MinWidth="90" Padding="12,6"
                        IsDefault="True"/>
                <Button x:Name="cancelButton"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        MinWidth="90" Padding="12,6"
                        IsCancel="True"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Border Padding="20">
            <StackPanel Spacing="16">

                <!-- Description -->
                <TextBlock Text="Which way would you like to move all controls on the map?"
                           FontSize="13" TextWrapping="Wrap" Foreground="#333"/>

                <!-- Radio Buttons -->
                <StackPanel Spacing="12">
                    <RadioButton x:Name="radioMove" GroupName="action">
                        <TextBlock Text="Move Only" FontSize="12"/>
                    </RadioButton>

                    <RadioButton x:Name="radioMoveScale" GroupName="action">
                        <TextBlock Text="Move and Scale" FontSize="12"/>
                    </RadioButton>

                    <RadioButton x:Name="radioMoveRotate" GroupName="action">
                        <TextBlock Text="Move and Rotate" FontSize="12"/>
                    </RadioButton>

                    <RadioButton x:Name="radioMoveRotateScale" GroupName="action">
                        <TextBlock Text="Move, Scale, and Rotate" FontSize="12"/>
                    </RadioButton>
                </StackPanel>

            </StackPanel>
        </Border>

    </DockPanel>

</Window>
